(in-package #:lustre-tests/tests)

(define-lustre-test sequencer-ordering-accessor-controls-test-and-parent-ordering
  (let* ((first-test (make-instance 'lustre-tests:test-object :name 'first-test))
         (second-test (make-instance 'lustre-tests:test-object :name 'second-test))
         (first-parent (make-instance 'lustre-tests:test-parent :name 'first-parent))
         (second-parent (make-instance 'lustre-tests:test-parent :name 'second-parent))
         (tests (list second-test first-test))
         (parents (list second-parent first-parent))
         (sequencer (make-instance 'lustre-tests:simple-test-sequencer)))
    (assert (eq :declaration-order (lustre-tests:test-sequencer-ordering sequencer)))
    (assert (equal (list first-test second-test)
                   (lustre-tests:sequence-tests sequencer tests)))
    (assert (equal (list first-parent second-parent)
                   (lustre-tests:sequence-parents sequencer parents)))
    (setf (lustre-tests:test-sequencer-ordering sequencer) :reverse-declaration-order)
    (assert (eq :reverse-declaration-order (lustre-tests:test-sequencer-ordering sequencer)))
    (assert (equal tests (lustre-tests:sequence-tests sequencer tests)))
    (assert (equal parents (lustre-tests:sequence-parents sequencer parents)))))

(define-lustre-test sequences-in-declaration-order-by-default
  (with-local-root (root)
    (lustre-tests:define-test t1 () T)
    (lustre-tests:define-test t2 () T)
    (lustre-tests:define-test t3 () T)
    (lustre-tests:define-test t4 () T)
    (lustre-tests:define-test final-test () T)
    (let* ((sequencer (make-instance 'lustre-tests:simple-test-sequencer))
           (result (lustre-tests:sequence-tests sequencer (lustre-tests:test-children root))))
      (assert (equalp (mapcar #'lustre-tests:test-name result)
                      '(t1 t2 t3 t4 final-test))))))

(define-lustre-test sequences-in-reverse-declaration-order
  (with-local-root (root)
    (lustre-tests:define-test t1 () T)
    (lustre-tests:define-test t2 () T)
    (lustre-tests:define-test t3 () T)
    (lustre-tests:define-test t4 () T)
    (lustre-tests:define-test final-test () T)
    (let* ((sequencer (make-instance 'lustre-tests:simple-test-sequencer
                                     :ordering :reverse-declaration-order))
           (result (lustre-tests:sequence-tests sequencer (lustre-tests:test-children root))))
      (assert (equalp (mapcar #'lustre-tests:test-name result)
                      '(final-test t4 t3 t2 t1))))))

(define-lustre-test sequences-in-random-order
  (with-local-root (root)
    (lustre-tests:define-test t1 () T)
    (lustre-tests:define-test t2 () T)
    (lustre-tests:define-test t3 () T)
    (lustre-tests:define-test t4 () T)
    (lustre-tests:define-test t5 () T)
    (lustre-tests:define-test t6 () T)
    (lustre-tests:define-test t7 () T)
    (lustre-tests:define-test t8 () T)
    (lustre-tests:define-test final-test () T)
    (flet ((do-sequence-tests ()
             (let* ((sequencer (make-instance 'lustre-tests:simple-test-sequencer
                                              :ordering :random)))
               (mapcar #'lustre-tests:test-name
                       (lustre-tests:sequence-tests sequencer (lustre-tests:test-children root))))))
      (let ((r1 (do-sequence-tests))
            (r2 (do-sequence-tests)))
        ;; sequencing twice should have an extremely low probability of the same result
        (assert-nil (equalp r1 r2))))))
