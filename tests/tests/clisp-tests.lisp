(in-package #:lustre-tests/tests)

(defvar *serial-execution-probe* nil)

(define-lustre-test clisp-parallel-traversal-is-serial
  (with-local-root (root)
    (lustre-tests:add-test (make-test-ok 'one) root)
    (lustre-tests:add-test (make-test-ok 'two) root)
    (lustre-tests:add-test (make-test-ok 'three) root '(nested))
    (let ((*serial-execution-probe* t)
          (sequencer (make-instance 'lustre-tests:simple-test-sequencer :ordering :reverse-declaration-order)))
      (flet ((events (traverse)
               (let ((events nil))
                 (funcall traverse root
                          (lambda (child)
                            (assert *serial-execution-probe*)
                            (push (list :test (lustre-tests:test-name child)) events))
                          (lambda (parent)
                            (push (list :start (lustre-tests:test-name parent)) events))
                          (lambda (parent)
                            (push (list :end (lustre-tests:test-name parent)) events))
                          sequencer)
                 (nreverse events))))
        (let ((serial (events #'lustre-tests:dotests))
              (parallel (events #'lustre-tests:dotests-parallel)))
          (assert (= 7 (length parallel)))
          (assert (equal serial parallel)))))))

(define-lustre-test clisp-parallel-test-requests-run-on-caller
  (with-local-root (root)
    (let ((*serial-execution-probe* t)
          (runs 0))
      (lustre-tests:define-test serial-root-test ()
        (assert *serial-execution-probe*)
        (incf runs))
      (lustre-tests:define-test serial-nested-test (nested)
        (assert *serial-execution-probe*)
        (incf runs))
      (dolist (run (list #'lustre-tests:test #'lustre-tests:test-simple))
        (setf runs 0)
        (with-output-to-string (stream)
          (funcall run :test-parent root :stream stream :parallel? t))
        (assert (= 2 runs))
        (assert (lustre-tests:test-passed? root))))))

(define-lustre-test clisp-event-ids-increase-without-threads
  (let ((lustre-tests::*id-counter* (lustre-tests::make-event-id-counter)))
    (assert (= 1 (lustre-tests::next-event-id)))
    (assert (= 2 (lustre-tests::next-event-id)))
    (assert (= 3 (lustre-tests::next-event-id)))))
